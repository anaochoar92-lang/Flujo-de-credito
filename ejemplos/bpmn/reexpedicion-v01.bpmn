      <bpmndi:BPMNShape id="S_ComunicarNuevo_di" bpmnElement="S_ComunicarNuevo">
        <dc:Bounds x="1940" y="361" width="148" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_NoValida_di" bpmnElement="S_NoValida">
        <dc:Bounds x="1540" y="441" width="148" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_FinNoValida_di" bpmnElement="S_FinNoValida">
        <dc:Bounds x="1740" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Inicio_di" bpmnElement="T_Inicio">
        <dc:Bounds x="140" y="722" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Solicitar_di" bpmnElement="T_Solicitar">
        <dc:Bounds x="340" y="701" width="148" height="78" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_RecibirNuevo_di" bpmnElement="T_RecibirNuevo">
        <dc:Bounds x="540" y="722" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Fin_di" bpmnElement="T_Fin">
        <dc:Bounds x="740" y="722" width="36" height="36" />
      </bpmndi:BPMNShape>
