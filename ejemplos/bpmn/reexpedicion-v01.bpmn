      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Reexpedicion_di" bpmnElement="Lane_Reexpedicion" isHorizontal="true">
        <dc:Bounds x="100" y="310" width="2178" height="260" />
      </bpmndi:BPMNShape>
