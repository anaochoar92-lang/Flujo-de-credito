        <dc:Bounds x="620" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="END_PAPEL_AGOTADO_di" bpmnElement="END_PAPEL_AGOTADO">
        <dc:Bounds x="872" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
