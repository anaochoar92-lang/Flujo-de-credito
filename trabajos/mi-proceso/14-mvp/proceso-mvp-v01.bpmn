      <bpmndi:BPMNShape id="TB_GW_VALIDO_di" bpmnElement="TB_GW_VALIDO" isMarkerVisible="true">
        <dc:Bounds x="770" y="345" width="50" height="50" />
      </bpmndi:BPMNShape>
