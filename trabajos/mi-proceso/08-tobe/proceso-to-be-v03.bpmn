    <bpmn:sequenceFlow id="F_001" sourceRef="EVT_001" targetRef="ACT_001" />
    <bpmn:sequenceFlow id="F_005" name="Corregir datos" sourceRef="GW_001" targetRef="ACT_001">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoRiesgo = "corregir"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_002" name="Enviar a Riesgo" sourceRef="ACT_001" targetRef="ACT_002" />
    <bpmn:sequenceFlow id="F_003" sourceRef="ACT_002" targetRef="GW_001" />
    <bpmn:sequenceFlow id="F_004" name="Apto" sourceRef="GW_001" targetRef="ACT_003">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoRiesgo = "apto"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_006" name="Rechazar" sourceRef="GW_001" targetRef="END_RECH_RIESGO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoRiesgo = "rechazar"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_015" name="Volver a análisis" sourceRef="ACT_005" targetRef="ACT_003" />
    <bpmn:sequenceFlow id="F_007" sourceRef="ACT_003" targetRef="GW_002" />
    <bpmn:sequenceFlow id="F_008" name="Aprobar (con o sin condiciones)" sourceRef="GW_002" targetRef="ACT_004">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionAnalisis = "aprobar"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_009" name="Rechazar" sourceRef="GW_002" targetRef="END_RECHAZADA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionAnalisis = "rechazar"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_010" sourceRef="ACT_004" targetRef="GW_003" />
    <bpmn:sequenceFlow id="F_011" name="No acepta" sourceRef="GW_003" targetRef="END_NO_ACEPTA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clienteAcepta = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_012" name="Acepta" sourceRef="GW_003" targetRef="GW_004">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=clienteAcepta = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_013" name="Con condiciones" sourceRef="GW_004" targetRef="ACT_005">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conCondiciones = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T01" name="Sin condiciones" sourceRef="GW_004" targetRef="TB_SND_ENLACE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conCondiciones = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T02" sourceRef="TB_SND_ENLACE" targetRef="SUB_T01" />
    <bpmn:sequenceFlow id="F_S02" sourceRef="SUB_T01" targetRef="TB_GW_CARGA" />
    <bpmn:sequenceFlow id="F_S03" name="Documentos válidos" sourceRef="TB_GW_CARGA" targetRef="TB_GW_SPLIT" />
    <bpmn:sequenceFlow id="F_S04" name="Intentos agotados: ruta en papel" sourceRef="TB_GW_CARGA" targetRef="ACT_006">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoValidacion = "agotado"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T13" sourceRef="TMR_T01" targetRef="SVC_001" />
    <bpmn:sequenceFlow id="F_T29" sourceRef="TMR_T02" targetRef="SVC_001" />
    <bpmn:sequenceFlow id="F_019" sourceRef="TMR_001" targetRef="SVC_001" />
    <bpmn:sequenceFlow id="F_020" sourceRef="SVC_001" targetRef="END_VENCIDA" />
    <bpmn:sequenceFlow id="F_T15" sourceRef="TB_GW_SPLIT" targetRef="TB_ACT_VERIF" />
    <bpmn:sequenceFlow id="F_T16" sourceRef="TB_GW_SPLIT" targetRef="TB_SND_RECOGIDA" />
    <bpmn:sequenceFlow id="F_T20" name="Documento corregido" sourceRef="TB_ACT_PEDIR" targetRef="TB_ACT_VERIF" />
    <bpmn:sequenceFlow id="F_T17" sourceRef="TB_ACT_VERIF" targetRef="TB_GW_VERIF" />
    <bpmn:sequenceFlow id="F_T18" name="OK" sourceRef="TB_GW_VERIF" targetRef="TB_GW_JOIN">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=expedienteOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T19" name="No cuadra" sourceRef="TB_GW_VERIF" targetRef="TB_ACT_PEDIR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=expedienteOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T21" sourceRef="TB_SND_RECOGIDA" targetRef="TB_ACT_RECOGER" />
    <bpmn:sequenceFlow id="F_T22" sourceRef="TB_ACT_RECOGER" targetRef="TB_GW_RECOGIDA" />
    <bpmn:sequenceFlow id="F_T23" name="Sí" sourceRef="TB_GW_RECOGIDA" targetRef="TB_ACT_ESCANEAR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=recogidaLograda = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T24" name="No" sourceRef="TB_GW_RECOGIDA" targetRef="TB_ACT_RECOP_ORIG">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=recogidaLograda = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T25" sourceRef="TB_ACT_RECOP_ORIG" targetRef="TB_ACT_ESCANEAR" />
    <bpmn:sequenceFlow id="F_T26" sourceRef="TB_ACT_ESCANEAR" targetRef="TB_GW_JOIN" />
    <bpmn:sequenceFlow id="F_T14" name="Ruta de respaldo" sourceRef="MSG_T01" targetRef="ACT_006" />
    <bpmn:sequenceFlow id="F_018" name="Incompleta: seguir recopilando" sourceRef="GW_005" targetRef="ACT_006">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentacionCompleta = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_024" name="Falta, no cuadra o documentos con más de 1 mes" sourceRef="GW_006" targetRef="ACT_006">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentacionOk = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_016" sourceRef="ACT_006" targetRef="GW_005" />
    <bpmn:sequenceFlow id="F_017" name="Completa" sourceRef="GW_005" targetRef="ACT_007">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentacionCompleta = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_021" name="Enviar a Despacho" sourceRef="ACT_007" targetRef="ACT_008" />
    <bpmn:sequenceFlow id="F_022" sourceRef="ACT_008" targetRef="GW_006" />
    <bpmn:sequenceFlow id="F_023" name="OK: enviar sobre" sourceRef="GW_006" targetRef="TB_GW_MERGE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=documentacionOk = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_T27" sourceRef="TB_GW_JOIN" targetRef="TB_GW_MERGE" />
    <bpmn:sequenceFlow id="F_T28" sourceRef="TB_GW_MERGE" targetRef="ACT_009" />
    <bpmn:sequenceFlow id="F_025" sourceRef="ACT_009" targetRef="END_DESEMBOLSADO" />
    <bpmn:boundaryEvent id="TMR_REC" name="Días hábiles 3 y 6 sin documentos válidos" cancelActivity="false" attachedToRef="SUB_T01">
      <bpmn:documentation>Ronda 14, medida 1 (REQ-TOBE-017). [PROPUESTA TÉCNICA] R2/P4D ≈ días hábiles 3 y 6 en días calendario, igual que P14D aproxima 10 días hábiles.</bpmn:documentation>
      <bpmn:outgoing>F_T31</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TMR_REC_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/P4D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
