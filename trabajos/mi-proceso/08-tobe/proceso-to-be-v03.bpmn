    </bpmn:boundaryEvent>
    <bpmn:userTask id="TB_ACT_LLAMAR" name="Llamar al cliente y enviar último aviso">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T33</bpmn:incoming>
      <bpmn:outgoing>F_T34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="TB_END_LLAM" name="Cliente contactado">
      <bpmn:incoming>F_T34</bpmn:incoming>
    </bpmn:endEvent>
