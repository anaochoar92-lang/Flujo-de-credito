<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_FlujoCredito_TOBE" targetNamespace="https://laboratorio.example.org/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:message id="Msg_Enlace" name="Correo con enlace al portal" />
  <bpmn:message id="Msg_DocsCargados" name="documentos-cargados">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=solicitudId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_FallaPortal" name="falla-portal-reportada">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=solicitudId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:collaboration id="Collaboration_Lab" name="Flujo de crédito preaprobado Expomóvil — TO-BE PROPUESTA v02 (NO APROBADO)">
    <bpmn:participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Banco" name="Banco — flujo de crédito preaprobado (TO-BE)" processRef="Process_Credito_TOBE" />
    <bpmn:messageFlow id="MF_Enlace" name="Correo con enlace" sourceRef="TB_SND_ENLACE" targetRef="CL_START" />
    <bpmn:messageFlow id="MF_Carga" name="Documentos cargados" sourceRef="CL_CARGAR" targetRef="TB_RCV_DOCS" />
    <bpmn:messageFlow id="MF_Corregir" name="Motivo y nueva carga" sourceRef="TB_SND_CORREGIR" targetRef="CL_CARGAR" />
    <bpmn:messageFlow id="MF_Llamada" name="Llamada y último aviso" sourceRef="TB_ACT_LLAMAR" targetRef="CL_CARGAR" />
    <bpmn:messageFlow id="MF_Pedir" name="Documento corregido" sourceRef="TB_ACT_PEDIR" targetRef="CL_CARGAR" />
    <bpmn:messageFlow id="MF_Recogida" name="Fecha de recogida" sourceRef="TB_SND_RECOGIDA" targetRef="CL_DEJAR" />
    <bpmn:messageFlow id="MF_Originales" name="Originales" sourceRef="CL_DEJAR" targetRef="TB_ACT_RECOGER" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cliente" name="Cliente" isExecutable="false">
    <bpmn:startEvent id="CL_START" name="Recibir correo con enlace">
      <bpmn:outgoing>F_C01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_Enlace" />
    </bpmn:startEvent>
    <bpmn:userTask id="CL_CARGAR" name="Cargar documentos en el portal (en el stand con un asesor o desde casa)">
      <bpmn:documentation>Ronda 14, medida 2 (PROC-TOBE-005): en la feria, un asesor de Negocio ayuda al cliente a cargar en el stand los documentos que ya trae, al aceptar la decisión.</bpmn:documentation>
      <bpmn:incoming>F_C01</bpmn:incoming>
      <bpmn:outgoing>F_C02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="CL_DEJAR" name="Dejar originales para recogida">
      <bpmn:incoming>F_C02</bpmn:incoming>
      <bpmn:outgoing>F_C03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="CL_END" name="Documentos entregados">
      <bpmn:incoming>F_C03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_C01" sourceRef="CL_START" targetRef="CL_CARGAR" />
    <bpmn:sequenceFlow id="F_C02" sourceRef="CL_CARGAR" targetRef="CL_DEJAR" />
    <bpmn:sequenceFlow id="F_C03" sourceRef="CL_DEJAR" targetRef="CL_END" />
  </bpmn:process>
  <bpmn:process id="Process_Credito_TOBE" name="Banco — solicitud de crédito Expomóvil (TO-BE)" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Process_Credito_TOBE">
      <bpmn:lane id="Lane_Desembolso" name="Desembolso">
        <bpmn:flowNodeRef>TB_GW_JOIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_MERGE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_DESEMBOLSADO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mensajero" name="Mensajero certificado">
        <bpmn:flowNodeRef>TB_ACT_RECOGER</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_RECOGIDA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Legal">
        <bpmn:flowNodeRef>TB_ACT_RECOP_ORIG</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_ACT_ESCANEAR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TMR_001</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema / portal (IT del banco)">
        <bpmn:flowNodeRef>TB_SND_ENLACE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_CARGA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SVC_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_VENCIDA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_SPLIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_SND_RECOGIDA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SUB_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MSG_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TMR_T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TMR_REC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_SND_RECORDAR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_END_REC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TMR_LLAM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista de crédito (Despacho)">
        <bpmn:flowNodeRef>TB_ACT_LLAMAR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_END_LLAM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_RECHAZADA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_NO_ACEPTA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_ACT_VERIF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_GW_VERIF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TB_ACT_PEDIR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TMR_T02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Riesgo" name="Persona de Riesgo">
        <bpmn:flowNodeRef>ACT_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>END_RECH_RIESGO</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Negocio" name="Persona de Negocio">
        <bpmn:flowNodeRef>EVT_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ACT_005</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="EVT_001" name="Cliente solicita crédito">
      <bpmn:outgoing>F_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ACT_001" name="Crear solicitud y entregar lista de los 4 documentos">
      <bpmn:documentation>Ronda 14, medida 2 (REQ-TOBE-019): al crear la solicitud se entrega al cliente la lista de documentos (identidad, comprobante de ingresos, estado de cuenta y pagaré) para que los reúna durante el análisis.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_001</bpmn:incoming>
      <bpmn:incoming>F_005</bpmn:incoming>
      <bpmn:outgoing>F_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ACT_002" name="Evaluar solicitud">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_002</bpmn:incoming>
      <bpmn:outgoing>F_003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_001" name="¿Cliente apto?">
      <bpmn:incoming>F_003</bpmn:incoming>
      <bpmn:outgoing>F_004</bpmn:outgoing>
      <bpmn:outgoing>F_005</bpmn:outgoing>
      <bpmn:outgoing>F_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="END_RECH_RIESGO" name="Solicitud rechazada por Riesgo">
      <bpmn:incoming>F_006</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ACT_003" name="Analizar crédito">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_004</bpmn:incoming>
      <bpmn:incoming>F_015</bpmn:incoming>
      <bpmn:outgoing>F_007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_002" name="¿Decisión del análisis?">
      <bpmn:incoming>F_007</bpmn:incoming>
      <bpmn:outgoing>F_008</bpmn:outgoing>
      <bpmn:outgoing>F_009</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="END_RECHAZADA" name="Solicitud rechazada">
      <bpmn:incoming>F_009</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ACT_004" name="Informar decisión al cliente">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_008</bpmn:incoming>
      <bpmn:outgoing>F_010</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_003" name="¿Cliente acepta y continúa?">
      <bpmn:incoming>F_010</bpmn:incoming>
      <bpmn:outgoing>F_011</bpmn:outgoing>
      <bpmn:outgoing>F_012</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="END_NO_ACEPTA" name="Solicitud cerrada: cliente no acepta">
      <bpmn:incoming>F_011</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_004" name="¿Aprobada con condiciones?">
      <bpmn:incoming>F_012</bpmn:incoming>
      <bpmn:outgoing>F_013</bpmn:outgoing>
      <bpmn:outgoing>F_T01</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACT_005" name="Modificar datos del crédito">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_013</bpmn:incoming>
      <bpmn:outgoing>F_015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="TB_SND_ENLACE" name="Enviar enlace al portal por correo [PROPUESTA]">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-correo-enlace" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T01</bpmn:incoming>
      <bpmn:outgoing>F_T02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:subProcess id="SUB_T01" name="Recibir y validar documentos en el portal">
      <bpmn:incoming>F_T02</bpmn:incoming>
      <bpmn:outgoing>F_S02</bpmn:outgoing>
      <bpmn:startEvent id="SUB_START" name="Enlace enviado">
        <bpmn:outgoing>F_S01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:receiveTask id="TB_RCV_DOCS" name="Recibir documentos cargados [PROPUESTA]" messageRef="Msg_DocsCargados">
        <bpmn:incoming>F_S01</bpmn:incoming>
        <bpmn:incoming>F_T09</bpmn:incoming>
        <bpmn:outgoing>F_T03</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:serviceTask id="TB_SVC_VALIDAR" name="Validar documentos: completos, ≤ 20 días y legibles [PROPUESTA]">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="validar-documentos" />
        </bpmn:extensionElements>
        <bpmn:incoming>F_T03</bpmn:incoming>
        <bpmn:outgoing>F_T04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="TB_GW_VALIDO" name="¿Resultado de la validación?">
        <bpmn:incoming>F_T04</bpmn:incoming>
        <bpmn:outgoing>F_T05</bpmn:outgoing>
        <bpmn:outgoing>F_T06</bpmn:outgoing>
        <bpmn:outgoing>F_T07</bpmn:outgoing>
        <bpmn:outgoing>F_T08</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sendTask id="TB_SND_CORREGIR" name="Pedir al cliente que vuelva a cargar [PROPUESTA]">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="enviar-correo-correccion" />
        </bpmn:extensionElements>
        <bpmn:incoming>F_T06</bpmn:incoming>
        <bpmn:incoming>F_T12</bpmn:incoming>
        <bpmn:outgoing>F_T09</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:userTask id="TB_ACT_REVISAR" name="Revisar documento dudoso (Legal)">
        <bpmn:extensionElements>
          <zeebe:userTask />
        </bpmn:extensionElements>
        <bpmn:incoming>F_T07</bpmn:incoming>
        <bpmn:outgoing>F_T10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="TB_GW_LEGAL" name="¿Legal lo acepta?">
        <bpmn:incoming>F_T10</bpmn:incoming>
        <bpmn:outgoing>F_T11</bpmn:outgoing>
        <bpmn:outgoing>F_T12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SUB_END_OK" name="Documentos válidos">
        <bpmn:incoming>F_T05</bpmn:incoming>
        <bpmn:incoming>F_T11</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SUB_END_PAPEL" name="Pasar a la ruta en papel">
        <bpmn:incoming>F_T08</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_S01" sourceRef="SUB_START" targetRef="TB_RCV_DOCS" />
      <bpmn:sequenceFlow id="F_T03" sourceRef="TB_RCV_DOCS" targetRef="TB_SVC_VALIDAR" />
      <bpmn:sequenceFlow id="F_T04" sourceRef="TB_SVC_VALIDAR" targetRef="TB_GW_VALIDO" />
      <bpmn:sequenceFlow id="F_T05" name="Válidos" sourceRef="TB_GW_VALIDO" targetRef="SUB_END_OK">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoValidacion = "valido"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_T06" name="Rechazado (menos de 5 intentos del documento)" sourceRef="TB_GW_VALIDO" targetRef="TB_SND_CORREGIR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoValidacion = "rechazado"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_T07" name="Dudoso: datos no coinciden" sourceRef="TB_GW_VALIDO" targetRef="TB_ACT_REVISAR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoValidacion = "dudoso"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_T08" name="5 intentos agotados en un documento" sourceRef="TB_GW_VALIDO" targetRef="SUB_END_PAPEL">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=resultadoValidacion = "agotado"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_T09" name="Esperar nueva carga" sourceRef="TB_SND_CORREGIR" targetRef="TB_RCV_DOCS" />
      <bpmn:sequenceFlow id="F_T10" sourceRef="TB_ACT_REVISAR" targetRef="TB_GW_LEGAL" />
      <bpmn:sequenceFlow id="F_T11" name="Acepta" sourceRef="TB_GW_LEGAL" targetRef="SUB_END_OK">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=legalAcepta = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_T12" name="No acepta" sourceRef="TB_GW_LEGAL" targetRef="TB_SND_CORREGIR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=legalAcepta = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="TB_GW_CARGA" name="¿Resultado de la carga?" default="F_S03">
      <bpmn:incoming>F_S02</bpmn:incoming>
      <bpmn:outgoing>F_S03</bpmn:outgoing>
      <bpmn:outgoing>F_S04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SVC_001" name="Cerrar solicitud automáticamente">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cerrar-solicitud" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T13</bpmn:incoming>
      <bpmn:incoming>F_T29</bpmn:incoming>
      <bpmn:incoming>F_019</bpmn:incoming>
      <bpmn:outgoing>F_020</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="END_VENCIDA" name="Solicitud cerrada por expediente incompleto">
      <bpmn:incoming>F_020</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:parallelGateway id="TB_GW_SPLIT" name="Expediente digital válido">
      <bpmn:incoming>F_S03</bpmn:incoming>
      <bpmn:outgoing>F_T15</bpmn:outgoing>
      <bpmn:outgoing>F_T16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="TB_ACT_VERIF" name="Verificar expediente digital (Despacho)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T15</bpmn:incoming>
      <bpmn:incoming>F_T20</bpmn:incoming>
      <bpmn:outgoing>F_T17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TB_GW_VERIF" name="¿Expediente digital OK?">
      <bpmn:incoming>F_T17</bpmn:incoming>
      <bpmn:outgoing>F_T18</bpmn:outgoing>
      <bpmn:outgoing>F_T19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TB_ACT_PEDIR" name="Pedir documento corregido al cliente">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T19</bpmn:incoming>
      <bpmn:outgoing>F_T20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="TB_SND_RECOGIDA" name="Programar recogida y avisar al cliente [PROPUESTA]">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="programar-recogida" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T16</bpmn:incoming>
      <bpmn:outgoing>F_T21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="TB_ACT_RECOGER" name="Recoger originales a domicilio">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T21</bpmn:incoming>
      <bpmn:outgoing>F_T22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="TB_GW_RECOGIDA" name="¿Recogida lograda?">
      <bpmn:incoming>F_T22</bpmn:incoming>
      <bpmn:outgoing>F_T23</bpmn:outgoing>
      <bpmn:outgoing>F_T24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="TB_ACT_RECOP_ORIG" name="Recopilar originales por la ruta actual">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T24</bpmn:incoming>
      <bpmn:outgoing>F_T25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="TB_ACT_ESCANEAR" name="Escanear originales y enviar sobre">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T23</bpmn:incoming>
      <bpmn:incoming>F_T25</bpmn:incoming>
      <bpmn:outgoing>F_T26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ACT_006" name="Recopilar expediente en papel (ruta de respaldo)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T14</bpmn:incoming>
      <bpmn:incoming>F_018</bpmn:incoming>
      <bpmn:incoming>F_024</bpmn:incoming>
      <bpmn:incoming>F_S04</bpmn:incoming>
      <bpmn:outgoing>F_016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_005" name="¿Documentación completa?">
      <bpmn:incoming>F_016</bpmn:incoming>
      <bpmn:outgoing>F_017</bpmn:outgoing>
      <bpmn:outgoing>F_018</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ACT_007" name="Escanear documentación">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_017</bpmn:incoming>
      <bpmn:outgoing>F_021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ACT_008" name="Verificar y autorizar expediente (Despacho)">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>F_021</bpmn:incoming>
      <bpmn:outgoing>F_022</bpmn:outgoing>
