      <bpmn:extensionElements>
        <zeebe:taskDefinition type="enviar-correo-recordatorio" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_T31</bpmn:incoming>
      <bpmn:outgoing>F_T32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="TB_END_REC" name="Recordatorio enviado">
      <bpmn:incoming>F_T32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="TMR_LLAM" name="Día hábil 8 sin documentos válidos" cancelActivity="false" attachedToRef="SUB_T01">
      <bpmn:documentation>Ronda 14, medida 1 (REQ-TOBE-018). [PROPUESTA TÉCNICA] P11D ≈ 8 días hábiles.</bpmn:documentation>
      <bpmn:outgoing>F_T33</bpmn:outgoing>
