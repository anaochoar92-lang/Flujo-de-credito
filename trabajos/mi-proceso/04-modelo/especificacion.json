        {"id": "Lane_Legal", "name": "Legal", "nodeIds": ["ACT_006", "TMR_001", "GW_005", "ACT_007"]},
        {"id": "Lane_Sistema", "name": "Sistema (cierre automático)", "nodeIds": ["SVC_001", "END_VENCIDA"]},
