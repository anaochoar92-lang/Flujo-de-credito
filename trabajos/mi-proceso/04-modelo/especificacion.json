        {"id": "F_014", "source": "GW_004", "target": "ACT_006", "name": "Sin condiciones"},
        {"id": "F_015", "source": "ACT_005", "target": "ACT_003", "name": "Volver a análisis"},
        {"id": "F_016", "source": "ACT_006", "target": "GW_005"},
        {"id": "F_017", "source": "GW_005", "target": "ACT_007", "name": "Completa"},
        {"id": "F_018", "source": "GW_005", "target": "ACT_006", "name": "Incompleta: seguir recopilando"},
        {"id": "F_019", "source": "TMR_001", "target": "SVC_001"},
        {"id": "F_020", "source": "SVC_001", "target": "END_VENCIDA"},
        {"id": "F_021", "source": "ACT_007", "target": "ACT_008", "name": "Enviar a Despacho"},
        {"id": "F_022", "source": "ACT_008", "target": "GW_006"},
        {"id": "F_023", "source": "GW_006", "target": "ACT_009", "name": "OK: enviar sobre"},
        {"id": "F_024", "source": "GW_006", "target": "ACT_006", "name": "Falta, se rechaza o no cuadra"},
        {"id": "F_025", "source": "ACT_009", "target": "END_DESEMBOLSADO"}
      ]
    }
